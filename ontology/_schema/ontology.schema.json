      "type": "string"
    },
    "RelationshipTypeSpec": {
      "additionalProperties": false,
      "description": "A structural, non-causal edge between two entity types.\n\n`CAUSES` is refused here by `structural.py`. `docs/contracts.md` §5 forbids it on\n`Relationship`, and a pack is the one place someone could reintroduce it as data.",
      "properties": {
        "cardinality": {
          "$ref": "#/$defs/Cardinality"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "from": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "From",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "temporal_validity": {
          "$ref": "#/$defs/TemporalValidity"
        },
        "to": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "To",
          "type": "string"
        }
      },

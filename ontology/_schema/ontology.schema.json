        "description",
        "from",
        "to",
        "cardinality",
        "temporal_validity"
      ],
      "title": "RelationshipTypeSpec",
      "type": "object"
    },
    "RemovalSpec": {
      "additionalProperties": false,
      "description": "Identifiers an overlay withdraws from the pack it extends.\n\nRemoval is explicit and per-identifier. An overlay cannot drop an inherited declaration\nby omitting it, because omission is indistinguishable from not having thought about it.",
      "properties": {
        "cost_classes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Cost Classes",
          "type": "array"
        },
        "entity_types": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Entity Types",
          "type": "array"
        },
        "event_categories": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Event Categories",
          "type": "array"
        },
        "event_types": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Event Types",
          "type": "array"
        },
        "external_event_types": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "External Event Types",
          "type": "array"
        },
        "measurement_definitions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Measurement Definitions",
          "type": "array"
        },
        "process_definitions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Process Definitions",
          "type": "array"
        },
        "relationship_types": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Relationship Types",
          "type": "array"
        },
        "risk_classes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Risk Classes",
          "type": "array"
        },
        "severity_classes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Severity Classes",
          "type": "array"
        }
      },
      "title": "RemovalSpec",
      "type": "object"
    },
    "TemporalValidity": {
      "description": "Whether a relationship holds for all time or only over an interval.\n\n`TIME_VARYING` tells the graph builder the edge needs a validity interval; `STATIC`\ntells it the edge does not. Guessing either way produces a graph that answers\n\"what was true then\" incorrectly.",
      "enum": [
        "STATIC",
        "TIME_VARYING"
      ],
      "title": "TemporalValidity",
      "type": "string"
    },
    "TransitionSpec": {
      "additionalProperties": false,
      "description": "One legal state transition, and optionally the event type that effects it.",
      "properties": {
        "from": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "From",
          "type": "string"
        },
        "to": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "To",
          "type": "string"
        },
        "triggered_by": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Triggered By"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "TransitionSpec",
      "type": "object"
    }
